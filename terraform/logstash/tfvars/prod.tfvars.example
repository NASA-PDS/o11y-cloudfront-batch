# Logstash EC2 module — prod venue
# Copy to prod.tfvars and fill in values.
# common-prod.tfvars supplies: tenant, cicd, component, managedby, resource_prefix
# Instance profile is created by terraform/iam/roles/ and read from SSM.

venue = "prod"

# Prod typically reuses an existing EC2 rather than having this module
# create one — see terraform/logstash/README.md "Using an existing EC2".
manage_ec2_instance  = false
existing_instance_id = "<existing-instance-id>"

logstash_version  = "8.17.0"
s3_cf_bucket_name = "<cf-logs-bucket-name>"  # S3 bucket for CloudFront logs (EN node only)
# repo_branch omitted — defaults to "main"

# --- Only needed if manage_ec2_instance = true (this module creates the EC2) ---
# vpc_id                  = ""                    # VPC ID for the Logstash EC2
# ec2_security_group_name = "<ec2-sg-name>"   # Name of the EC2 security group
# ami_id                  = "<ami-id>"             # AMI ID for the Logstash EC2 instance
# logstash_instance_type  = "t3.large"
