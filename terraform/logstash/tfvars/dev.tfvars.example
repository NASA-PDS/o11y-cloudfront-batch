# Logstash EC2 module — dev venue
# Copy to dev.tfvars and fill in values.
# common-dev.tfvars supplies: tenant, cicd, component, managedby, resource_prefix
# Instance profile is created by terraform/iam/roles/ and read from SSM.
#
# dev creates its own EC2 (manage_ec2_instance defaults to true). To instead
# point at an existing instance, set manage_ec2_instance = false and
# existing_instance_id — see terraform/logstash/README.md "Using an existing EC2".

venue = "dev"

vpc_id                  = ""                    # VPC ID for the Logstash EC2
ec2_security_group_name = "<ec2-sg-name>"   # Name of the EC2 security group
ami_id                  = "<ami-id>"             # SA-managed private AMI (pdsops key-user pre-provisioned)
logstash_instance_type  = "t3.large"
logstash_version        = "8.17.0"
s3_cf_bucket_name       = "<cf-logs-bucket-name>"  # S3 bucket for CloudFront logs (EN node only)
repo_branch             = "develop"                # Branch to clone at first boot (prod: omit to use default "main")
