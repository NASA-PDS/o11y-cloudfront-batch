# IAM - prod venue
# Copy to prod.tfvars and fill in values.
# Shared values (aws_region, partition, tenant, component, cicd) are in common-prod.tfvars.

venue                       = "prod"
managedby                   = "<your-email>"
ec2users_dynamodb_table_arn = "<arn:aws:dynamodb:us-west-2:account-id:table/ec2users>"

logs_s3_bucket_name = ""  # full S3 bucket name (e.g. pds-prod-logs)
