# IAM-module dev values — copy to dev.tfvars and fill in values.
# Shared values (aws_region, partition, etc.) are in common-dev.tfvars.
# EC2 role name is read from SSM (published by terraform/iam/roles/).

venue     = "dev"
managedby = "<your-email>"

logs_s3_bucket_name = ""  # full S3 bucket name (e.g. pds-dev-gh01dc-logs)
