# IAM-module prod values — copy to prod.tfvars and fill in values.
# Shared values (aws_region, partition, etc.) are in common-prod.tfvars.
# EC2 role name is read from SSM (published by terraform/iam/roles/).

venue     = "prod"
managedby = "<your-email>"

logs_s3_bucket_name = ""  # full S3 bucket name (e.g. pds-prod-logs)
