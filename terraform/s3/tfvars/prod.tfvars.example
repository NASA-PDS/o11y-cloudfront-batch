# Root-module prod values — module-specific only.
# Shared values (aws_region, partition, resource_prefix, etc.) are in common-prod.tfvars.

venue     = "prod"
managedby = "<your-email>"

s3_bucket_prefix = ""  # e.g. pds-prod-gh01dc — the "gh01dc" is a legacy artifact of an early
                        # GitHub CD/OIDC deploy design (since dropped); the live bucket keeps
                        # this prefix since it was never renamed. See terraform/s3/README.md.
